{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/(create-room|room-status|host-action|join-room|submit-answer)", "dest": "/server.js" },
    { "src": "/player(.html)?", "dest": "/public/player.html" },
    { "src": "/host(.html)?", "dest": "/public/host.html" },
    { "src": "^/$", "dest": "/public/host.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
