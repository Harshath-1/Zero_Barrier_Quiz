{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "^/$", "dest": "/public/host.html" },
    { "src": "^/host$", "dest": "/public/host.html" },
    { "src": "^/player$", "dest": "/public/player.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
